# Co-writing board: all drafts grouped by status (install a Kanban Bases View plugin to drag cards)
filters:
  and:
    - 'type == "draft"'
    - file.inFolder("03-Projects")
views:
  - type: table
    name: Co-writing board
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - topic
      - version
      - authored_by
      - updated
      - due
