# AI participation audit: files carrying authored_by, for post-hoc fact-check triage
filters:
  and:
    - 'authored_by != ""'
    - file.inFolder("03-Projects")
views:
  - type: table
    name: AI audit
    order:
      - file.name
      - authored_by
      - ai_level
      - ai_model
      - updated
